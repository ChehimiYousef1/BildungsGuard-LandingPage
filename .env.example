# ---------------------------------------------------------------- public ----
# Exposed to the browser. Never put a secret in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SITE_URL=https://bildungsguard.de
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_API_URL=

# ------------------------------------------------------------------ mail ----
# Server-only. Required for the demo booking form to send anything.
SMTP_HOST=smtp.your-provider.de
SMTP_PORT=587
# Leave unset to derive from the port: 465 = implicit TLS, 587 = STARTTLS.
SMTP_SECURE=
SMTP_USER=noreply@bildungsguard.de
SMTP_PASSWORD=

# Sender shown to the customer. Must be a domain you are allowed to send from.
MAIL_FROM="Bildungs Guard <noreply@bildungsguard.de>"

# Internal inbox that receives every booking.
MAIL_TO=demo@bildungsguard.de

# Where customer replies land. Defaults to MAIL_TO when empty.
MAIL_REPLY_TO=
